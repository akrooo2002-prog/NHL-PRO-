# Copié en /opt/nhl-pronos/deploy/nhl-pronos.env par deploy.sh install.
# chmod 600 : ce fichier peut contenir un secret.

# N'écouter que sur cette interface. Laisse 0.0.0.0 quand Caddy fait le TLS sur
# la même machine ; mets 127.0.0.1 si rien d'autre ne doit pouvoir joindre le
# port directement (accès uniquement via Caddy ou tailscale serve).
NHL_BIND=0.0.0.0

# Jeton du déclenchement à distance : GET /api/refresh?lancer=1&token=...
# Vide = le bouton de l'interface suffit (recommandé). Généré par deploy.sh.
NHL_REFRESH_TOKEN=
